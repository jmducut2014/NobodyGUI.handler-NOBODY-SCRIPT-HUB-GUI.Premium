createInputButton(desSubs["Utility"], "Fling Player",
	"Teleport-spin into target to launch them", "Player name...", "FLING", function(inputText)
	if inputText == "" then notify("Enter a player name", "error"); return end
	local c = player.Character; local myHRP = c and c:FindFirstChild("HumanoidRootPart")
	local myHum = c and c:FindFirstChildOfClass("Humanoid")
	if not myHRP or not myHum then notify("No character", "error"); return end
	local target = nil
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Name:lower():find(inputText:lower()) then
			local pc = p.Character; local phrp = pc and pc:FindFirstChild("HumanoidRootPart")
			if phrp then target = phrp; break end
		end
	end
	if not target then notify("Player not found", "error"); return end
	local tPos = target.Position
	local origCF  = myHRP.CFrame
	local origWS  = myHum.WalkSpeed; local origJP = myHum.JumpPower
	myHum.WalkSpeed = 0; myHum.JumpPower = 0; myHum.PlatformStand = true
	RunService:UnbindFromRenderStep("NoclipUpdate")
	local bv = Instance.new("BodyVelocity", myHRP)
	bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge); bv.Velocity = Vector3.new(0,0,0)
	local cleaned = false
	local function cleanup()
		if cleaned then return end; cleaned = true
		if bv and bv.Parent then bv:Destroy() end
		myHum.WalkSpeed = origWS; myHum.JumpPower = origJP
		myHum.PlatformStand = false; myHum.AutoRotate = true
		myHRP.Anchored = true; myHRP.Velocity = Vector3.new(0,0,0)
		myHRP.CFrame = origCF; task.wait(0.2); myHRP.Anchored = false
		myHum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
	local start = tick(); local conn
	conn = RunService.Heartbeat:Connect(function()
		if not bv or not bv.Parent then cleanup(); conn:Disconnect(); return end
		local elapsed = tick() - start
		if elapsed > 0.6 then cleanup(); conn:Disconnect(); return end
		local angle = elapsed * 40
		local offset = Vector3.new(math.sin(angle) * 2, 0, math.cos(angle) * 2)
		local frame  = elapsed % 0.06 < 0.03
		myHRP.CFrame = frame and CFrame.new(tPos) or CFrame.new(tPos + offset)
		bv.Velocity  = frame and (myHRP.Position - target.Position).Unit * -9999
		                      or Vector3.new(math.sin(angle)*9999, 200, math.cos(angle)*9999)
	end)
	notify("Flinging " .. inputText, "success")
end)
divider(desSubs["Utility"])

createInputButton(desSubs["Utility"], "Kill Player (Fling)",
	"Rapid-fling a specific player to kill them", "Player name...", "KILL", function(inputText)
	-- re-uses fling logic — same effect, semantic label
	if inputText == "" then notify("Enter name", "error"); return end
	local c = player.Character; local myHRP = c and c:FindFirstChild("HumanoidRootPart")
	local myHum = c and c:FindFirstChildOfClass("Humanoid")
	if not myHRP or not myHum then return end
	local target = nil
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Name:lower():find(inputText:lower()) then
			local pc = p.Character; local phrp = pc and pc:FindFirstChild("HumanoidRootPart")
			if phrp then target = phrp; break end
		end
	end
	if not target then notify("Not found", "error"); return end
	local tPos = target.Position
	local origCF = myHRP.CFrame; local origWS = myHum.WalkSpeed; local origJP = myHum.JumpPower
	myHum.WalkSpeed = 0; myHum.JumpPower = 0; myHum.PlatformStand = true
	local bv = Instance.new("BodyVelocity", myHRP)
	bv.MaxForce = Vector3.new(math.huge,math.huge,math.huge); bv.Velocity = Vector3.new(0,0,0)
	local start = tick(); local cleaned = false; local conn
	conn = RunService.Heartbeat:Connect(function()
		if not bv or not bv.Parent then conn:Disconnect(); return end
		local e = tick() - start
		if e > 0.5 then
			if not cleaned then cleaned = true
				if bv.Parent then bv:Destroy() end
				myHum.WalkSpeed = origWS; myHum.JumpPower = origJP; myHum.PlatformStand = false
				myHRP.Anchored = true; myHRP.CFrame = origCF
				task.wait(0.2); myHRP.Anchored = false
			end
			conn:Disconnect(); return
		end
		local a = e * 50
		myHRP.CFrame = CFrame.new(tPos + Vector3.new(math.sin(a)*1.5, 0, math.cos(a)*1.5))
		bv.Velocity = Vector3.new(math.sin(a)*12000, 500, math.cos(a)*12000)
	end)
	notify("Killing " .. inputText, "success")
end)
