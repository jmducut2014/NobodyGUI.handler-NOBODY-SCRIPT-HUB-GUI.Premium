createButton(charSubs["Teleport"], "Teleport to Nearest Player",
	"Instantly warps behind the closest player", function()
	local c = player.Character; local hrp = c and c:FindFirstChild("HumanoidRootPart")
	if not hrp then notify("No character", "error"); return end
	local best, bestDist = nil, math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local pc = p.Character; local phrp = pc and pc:FindFirstChild("HumanoidRootPart")
			if phrp then
