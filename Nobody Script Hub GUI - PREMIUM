createToggle(desSubs["Aim"], "Aimbot", "Hold LMB to snap camera to nearest enemy", function(on)
	if on then
		RunService:BindToRenderStep("AimbotUpdate", Enum.RenderPriority.Camera.Value+1, function()
			if not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then return end
			local cam = workspace.CurrentCamera
			local best, bestDist = nil, math.huge
			local cx, cy = cam.ViewportSize.X/2, cam.ViewportSize.Y/2
			for _, p in ipairs(Players:GetPlayers()) do
				repeat
				if p == player then break end
				local ch = p.Character; local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
				if not hrp then break end
				local sp, onScreen = cam:WorldToScreenPoint(hrp.Position)
				if not onScreen then break end
				local d = ((Vector2.new(sp.X,sp.Y)) - Vector2.new(cx,cy)).Magnitude
				if d < bestDist then bestDist = d; best = hrp end
				until true
			end
			if best then
				cam.CFrame = CFrame.new(cam.CFrame.Position, best.Position + Vector3.new(0,1.5,0))
