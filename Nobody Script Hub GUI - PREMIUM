	local logLayout = Instance.new("UIListLayout", logScroll)
	logLayout.Padding     = UDim.new(0, 2)
	logLayout.SortOrder   = Enum.SortOrder.LayoutOrder
	local logCorner = Instance.new("UICorner", logScroll)
	logCorner.CornerRadius = UDim.new(0, 8)
	local logPad = Instance.new("UIPadding", logScroll)
	logPad.PaddingLeft = UDim.new(0, 6); logPad.PaddingTop = UDim.new(0, 4)

	local logCount = 0
	local maxLogs  = 80

	local function addLog(speaker, msg, color)
		logCount = logCount + 1
		local row = Instance.new("TextLabel", logScroll)
		row.Size                   = UDim2.new(1, -10, 0, 16)
		row.BackgroundTransparency = 1
		row.Text                   = "[" .. speaker .. "]: " .. msg
		row.TextColor3             = color or Color3.fromRGB(200, 200, 220)
		row.Font                   = Enum.Font.Gotham
		row.TextSize               = 11
		row.TextXAlignment         = Enum.TextXAlignment.Left
		row.TextTruncate           = Enum.TextTruncate.AtEnd
		row.LayoutOrder            = logCount
		-- auto-scroll to bottom
		logScroll.CanvasPosition   = Vector2.new(0, math.huge)
		-- trim old entries
		local children = logScroll:GetChildren()
		local labels   = {}
		for _, c in ipairs(children) do
			if c:IsA("TextLabel") then
				labels[#labels + 1] = c
			end
		end
		if #labels > maxLogs then
			labels[1]:Destroy()
		end
	end

	-- hook all players including future joiners
	local function hookPlayer(p)
		p.Chatted:Connect(function(msg)
			local col = (p == player)
				and Color3.fromRGB(120, 200, 255)
				or  Color3.fromRGB(200, 200, 220)
			addLog(p.Name, msg, col)
		end)
	end

	for _, p in ipairs(Players:GetPlayers()) do
		hookPlayer(p)
	end
	Players.PlayerAdded:Connect(hookPlayer)

	addLog("System", "Chat logger active — all messages captured", Color3.fromRGB(60, 220, 140))

	-- clear button
	divider(utilSubs["Logger"])
	createButton(utilSubs["Logger"], "Clear Log", "Wipes all captured chat messages", function()
		for _, c in ipairs(logScroll:GetChildren()) do
			if c:IsA("TextLabel") then c:Destroy() end
		end
		logCount = 0
		addLog("System", "Log cleared", Color3.fromRGB(60, 220, 140))
		notify("Chat log cleared", "success")
	end)
end

