-- ── Run key check ──────────────────────────────
local keyPassed = false
local keyDead   = false
local attempts  = 0

local keySG, keyCard, keyTB, keySubmit, keyStatus, keyInputStroke = buildKeyGUI()

local function tryKey()
	local entered = keyTB.Text
	if entered == _ck then
		-- correct — flash green and destroy
		keyStatus.Text       = "✓  Access granted"
		keyStatus.TextColor3 = Color3.fromRGB(60, 220, 140)
		_TweenService:Create(keyInputStroke, TweenInfo.new(0.2),
			{Color = Color3.fromRGB(60, 220, 140)}):Play()
		_TweenService:Create(keyCard, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In),
			{Position = UDim2.new(0.5, 0, 0.44, 0)}):Play()
		task.wait(0.6)
		_TweenService:Create(keySG:FindFirstChildOfClass("Frame"),
			TweenInfo.new(0.3, Enum.EasingStyle.Quart),
			{BackgroundTransparency = 1}):Play()
		task.wait(0.35)
		keySG:Destroy()
		keyPassed = true
	else
		-- wrong key
		attempts = attempts + 1
		_TweenService:Create(keyInputStroke, TweenInfo.new(0.1),
			{Color = Color3.fromRGB(255, 90, 90)}):Play()
		task.delay(1, function()
			_TweenService:Create(keyInputStroke, TweenInfo.new(0.2),
				{Color = Color3.fromRGB(55, 55, 80)}):Play()
		end)

		if attempts >= MAX_ATTEMPTS then
			keyStatus.Text       = "✕  Too many attempts — rerun the script"
			keyStatus.TextColor3 = Color3.fromRGB(255, 90, 90)
			keySubmit.Active     = false
			keySubmit.BackgroundColor3 = Color3.fromRGB(60, 40, 40)
			keyTB.Editable       = false
			-- wait a moment so the message is readable, then destroy everything
			task.delay(2.5, function()
				-- fade the card out
				_TweenService:Create(keyCard, TweenInfo.new(0.4, Enum.EasingStyle.Quart),
					{BackgroundTransparency = 1, Position = UDim2.new(0.5, 0, 0.56, 0)}):Play()
				_TweenService:Create(keySG:FindFirstChildOfClass("Frame"),
					TweenInfo.new(0.4, Enum.EasingStyle.Quart),
					{BackgroundTransparency = 1}):Play()
				task.wait(0.45)
				keySG:Destroy()
				keyDead = true
			end)
		else
			keyStatus.Text = "✕  Incorrect key  (" .. (MAX_ATTEMPTS - attempts) .. " attempt"
				.. (MAX_ATTEMPTS - attempts == 1 and "" or "s") .. " remaining)"
			keyStatus.TextColor3 = Color3.fromRGB(255, 90, 90)
			-- shake the card
			local origPos = UDim2.new(0.5, 0, 0.5, 0)
			_TweenService:Create(keyCard, TweenInfo.new(0.05), {Position = UDim2.new(0.5, -10, 0.5, 0)}):Play()
			task.wait(0.06)
			_TweenService:Create(keyCard, TweenInfo.new(0.05), {Position = UDim2.new(0.5, 10, 0.5, 0)}):Play()
			task.wait(0.06)
			_TweenService:Create(keyCard, TweenInfo.new(0.05), {Position = UDim2.new(0.5, -6, 0.5, 0)}):Play()
			task.wait(0.06)
			_TweenService:Create(keyCard, TweenInfo.new(0.12, Enum.EasingStyle.Back), {Position = origPos}):Play()
		end
	end
end

keySubmit.MouseButton1Click:Connect(tryKey)
keyTB.FocusLost:Connect(function(enter) if enter then tryKey() end end)

-- wait until key is accepted before loading the rest of the hub
repeat task.wait(0.1) until keyPassed or keyDead
if keyDead then return end

